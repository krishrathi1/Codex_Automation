DATABASE_URL="postgresql://user:password@localhost:5432/nexus"
PORT=4000

# Required in production (min 32 chars each)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Local development admin ─────────────────────────────
# Only used outside production. The backend repairs this user on startup.
DEV_ADMIN_EMAIL=admin@nexus.local
DEV_ADMIN_PASSWORD=admin123
DEV_ADMIN_NAME=Admin
DEV_ADMIN_ORG_NAME=Nexus Local
DISABLE_DEV_ADMIN_BOOTSTRAP=false

# AES-256 key for encrypting sensitive data at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── SMTP (Email Verification) ──────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nexus <noreply@example.com>
APP_URL=http://localhost:5174

AGENT_RUNTIME=claude-cli

# ── Claude CLI paths & commands ─────────────────────────────────
# Absolute path to claude binary (takes priority over CLAUDE_COMMAND)
CLAUDE_CLI_PATH=
# Command name on PATH (fallback; defaults to 'claude')
CLAUDE_COMMAND=
# Model to use (optional; uses Claude's default if empty)
CLAUDE_MODEL=
# Override workspace root (defaults to project root)
CLAUDE_WORKSPACE_ROOT=
# Operation timeout in ms (default: 15 minutes)
CLAUDE_OPERATION_TIMEOUT_MS=

# ── Platform LLM API Keys (used when orgs select PLATFORM mode) ──
PLATFORM_OPENAI_API_KEY=
PLATFORM_GOOGLE_API_KEY=
PLATFORM_MISTRAL_API_KEY=
PLATFORM_GROQ_API_KEY=
PLATFORM_OPENROUTER_API_KEY=

# ── Default Gateway (auto-provisioned for new orgs) ──────
# When set, each new organization automatically gets a gateway — users never see gateway setup.
# The URL should be a WebSocket URL pointing to your OpenClaw gateway instance.
DEFAULT_GATEWAY_URL=
DEFAULT_GATEWAY_TOKEN=
DEFAULT_GATEWAY_WORKSPACE=

# ── Mutual Fund Co-Pilot — Production Monitor ────────────
# This monitor polls Vercel and GitHub for errors, auto-fixes them with Claude CLI,
# and pushes the fix to GitHub (which triggers a Vercel redeploy).
#
# Step 1 — Vercel (get token from vercel.com/account/tokens)
VERCEL_TOKEN=
# Get project ID from: vercel project ls  or  vercel.com/<project>/settings
VERCEL_PROJECT_ID=
# Alternative: use project name if ID is unknown (default: mutual-fund)
VERCEL_PROJECT_NAME=mutual-fund
# Team ID — only needed if using a Vercel team account
VERCEL_TEAM_ID=
#
# Step 2 — GitHub (get token from github.com/settings/tokens, needs repo + workflow scopes)
GITHUB_TOKEN=
# Format: owner/repo-name
GITHUB_REPO=krishrathi1/Mutual-Fund-Co-Pilot-
# Branch to push fixes to (default: main)
GITHUB_BRANCH=main
#
# Step 3 — Local workspace (where the repo is cloned for Claude CLI to edit)
# Clone the repo first: git clone https://github.com/krishrathi1/Mutual-Fund-Co-Pilot-.git /path/to/workspace
MUTUAL_FUND_WORKSPACE=
#
# Step 4 — Nexus config
# Organization ID in Nexus to attach pipeline agents (leave empty to use first org)
MUTUAL_FUND_ORG_ID=
# Optional: pin errors to a specific board ID
MUTUAL_FUND_BOARD_ID=
# Poll interval in milliseconds (default: 300000 = 5 minutes)
MUTUAL_FUND_MONITOR_INTERVAL_MS=300000
# Set to 'true' to disable the monitor without removing config
MUTUAL_FUND_MONITOR_DISABLED=false
